// Version resource of fsvncupdater.exe. The binary is the same release as
// the viewer; keep these numbers in step with tvnviewer.rc.

#include <winver.h>

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,1,0
 PRODUCTVERSION 1,0,1,0
 FILEFLAGSMASK 0x17L
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "FarSightVNC contributors"
            VALUE "FileDescription", "FarSightVNC Updater"
            VALUE "FileVersion", "1.0.1a"
            VALUE "InternalName", "fsvncupdater"
            VALUE "LegalCopyright", "Copyright (C) 2026 FarSightVNC contributors. Licensed under the GNU GPL, version 2 or (at your option) any later version. Based on TightVNC Viewer 2.8.90."
            VALUE "OriginalFilename", "fsvncupdater.exe"
            VALUE "ProductName", "FarSightVNC"
            VALUE "ProductVersion", "1.0.1a"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
