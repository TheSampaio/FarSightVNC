{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "vs18",
      "hidden": true,
      "description": "Visual Studio 18 2026 (MSVC v145); output stays out of build/bin and build/obj (MSBuild).",
      "generator": "Visual Studio 18 2026",
      "binaryDir": "${sourceDir}/build/cmake/${presetName}",
      "cacheVariables": {
        "FSV_USE_PCH": "ON"
      }
    },
    {
      "name": "x64-debug",
      "displayName": "x64 Debug",
      "inherits": "vs18",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug" }
    },
    {
      "name": "x64-release",
      "displayName": "x64 Release",
      "inherits": "vs18",
      "architecture": { "value": "x64", "strategy": "set" },
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Release" }
    },
    {
      "name": "win32-debug",
      "displayName": "Win32 Debug",
      "inherits": "vs18",
      "architecture": { "value": "Win32", "strategy": "set" },
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Debug" }
    },
    {
      "name": "win32-release",
      "displayName": "Win32 Release",
      "inherits": "vs18",
      "architecture": { "value": "Win32", "strategy": "set" },
      "cacheVariables": { "CMAKE_CONFIGURATION_TYPES": "Release" }
    }
  ],
  "buildPresets": [
    { "name": "x64-debug", "configurePreset": "x64-debug", "configuration": "Debug" },
    { "name": "x64-release", "configurePreset": "x64-release", "configuration": "Release" },
    { "name": "win32-debug", "configurePreset": "win32-debug", "configuration": "Debug" },
    { "name": "win32-release", "configurePreset": "win32-release", "configuration": "Release" }
  ],
  "testPresets": [
    {
      "name": "x64-debug",
      "configurePreset": "x64-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "x64-release",
      "configurePreset": "x64-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "win32-debug",
      "configurePreset": "win32-debug",
      "configuration": "Debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "win32-release",
      "configurePreset": "win32-release",
      "configuration": "Release",
      "output": { "outputOnFailure": true }
    }
  ]
}
